# -------------------------------------------------------
# EcoFix AI — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.
# -------------------------------------------------------

# Optional: OpenAI API key for gpt-4o-mini enhanced repair guides.
# If absent, the app falls back to keyword/rule-based matching.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Earth911 API key for live e-waste recycling hub lookup.
# If absent, the app uses the bundled data/recycling_hubs.csv fallback.
EARTH911_API_KEY=your_earth911_api_key_here
