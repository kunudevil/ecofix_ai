# .streamlit/secrets.toml.example
# -------------------------------------------------------
# Copy this file to .streamlit/secrets.toml for local Streamlit secrets,
# OR paste these key=value pairs into Streamlit Community Cloud →
# App Settings → Secrets when deploying.
# NEVER commit secrets.toml to version control.
# -------------------------------------------------------

# OpenAI API key — enables gpt-4o-mini enhanced repair guidance
OPENAI_API_KEY = "sk-proj-..."

# Earth911 API key — enables live e-waste hub lookup
# Leave blank to use the bundled CSV fallback (recommended for demos)
EARTH911_API_KEY = ""
